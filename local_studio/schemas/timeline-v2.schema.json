{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grok-crew.timeline/v2",
  "title": "Grok Crew Timeline v2",
  "$defs": {
    "keyframe": {
      "type": "object",
      "required": ["id", "at", "value", "interpolation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "at": { "type": "number", "minimum": 0 },
        "value": { "type": "number" },
        "interpolation": { "enum": ["linear", "hold"] }
      },
      "additionalProperties": false
    },
    "keyframeTrack": {
      "type": "array",
      "maxItems": 250,
      "items": { "$ref": "#/$defs/keyframe" }
    },
    "transition": {
      "type": "object",
      "required": ["type", "duration"],
      "properties": {
        "type": { "enum": ["fade", "crossfade", "dip_black"] },
        "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema", "revision", "settings", "assets", "tracks", "markers"],
  "properties": {
    "schema": { "const": "grok-crew.timeline/v2" },
    "revision": { "type": "integer", "minimum": 1 },
    "settings": {
      "type": "object",
      "required": ["width", "height", "fps", "quality"],
      "properties": {
        "width": { "type": "integer", "minimum": 2 },
        "height": { "type": "integer", "minimum": 2 },
        "fps": { "enum": [24, 30, 60] },
        "quality": { "enum": ["compact", "balanced", "high"] },
        "background": { "type": "string" },
        "snapping_enabled": { "type": "boolean", "default": true },
        "snap_tolerance_frames": { "type": "integer", "minimum": 1, "maximum": 60, "default": 6 }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["video", "image", "audio", "title", "generator"] },
          "name": { "type": "string" },
          "text": { "type": "string" },
          "path": { "type": "string" },
          "duration": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "order", "locked", "muted", "clips"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["video", "audio", "caption", "overlay", "adjustment"] },
          "name": { "type": "string" },
          "order": { "type": "integer" },
          "locked": { "type": "boolean" },
          "muted": { "type": "boolean" },
          "solo": { "type": "boolean", "default": false },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "timeline_start", "duration", "locked"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "asset_id": { "type": ["string", "null"] },
                "timeline_start": { "type": "number", "minimum": 0 },
                "duration": { "type": "number", "exclusiveMinimum": 0 },
                "source_in": { "type": "number", "minimum": 0 },
                "source_out": { "type": "number", "minimum": 0 },
                "locked": { "type": "boolean" },
                "group_id": { "type": ["string", "null"], "minLength": 1 },
                "transition_in": { "$ref": "#/$defs/transition" },
                "transition_out": { "$ref": "#/$defs/transition" },
                "text": { "type": "string" },
                "transform": { "type": "object" },
                "audio": { "type": "object" },
                "effects": { "type": "array" },
                "keyframes": {
                  "type": "object",
                  "properties": {
                    "x": { "$ref": "#/$defs/keyframeTrack" },
                    "y": { "$ref": "#/$defs/keyframeTrack" },
                    "scale": { "$ref": "#/$defs/keyframeTrack" },
                    "rotation": { "$ref": "#/$defs/keyframeTrack" },
                    "crop_left": { "$ref": "#/$defs/keyframeTrack" },
                    "crop_right": { "$ref": "#/$defs/keyframeTrack" },
                    "crop_top": { "$ref": "#/$defs/keyframeTrack" },
                    "crop_bottom": { "$ref": "#/$defs/keyframeTrack" },
                    "opacity": { "$ref": "#/$defs/keyframeTrack" },
                    "volume": { "$ref": "#/$defs/keyframeTrack" },
                    "speed": { "$ref": "#/$defs/keyframeTrack" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "at"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "at": { "type": "number", "minimum": 0 },
          "label": { "type": "string", "maxLength": 120 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
