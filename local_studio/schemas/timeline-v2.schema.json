{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grok-crew.timeline/v2",
  "title": "Grok Crew Timeline v2",
  "type": "object",
  "required": ["schema", "revision", "settings", "assets", "tracks", "markers"],
  "properties": {
    "schema": { "const": "grok-crew.timeline/v2" },
    "revision": { "type": "integer", "minimum": 1 },
    "settings": {
      "type": "object",
      "required": ["width", "height", "fps", "quality"],
      "properties": {
        "width": { "type": "integer", "minimum": 2 },
        "height": { "type": "integer", "minimum": 2 },
        "fps": { "enum": [24, 30, 60] },
        "quality": { "enum": ["compact", "balanced", "high"] },
        "background": { "type": "string" }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["video", "image", "audio", "title", "generator"] },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "duration": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "order", "locked", "muted", "clips"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["video", "audio", "caption", "overlay", "adjustment"] },
          "name": { "type": "string" },
          "order": { "type": "integer" },
          "locked": { "type": "boolean" },
          "muted": { "type": "boolean" },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "timeline_start", "duration", "locked"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "asset_id": { "type": ["string", "null"] },
                "timeline_start": { "type": "number", "minimum": 0 },
                "duration": { "type": "number", "exclusiveMinimum": 0 },
                "source_in": { "type": "number", "minimum": 0 },
                "source_out": { "type": "number", "minimum": 0 },
                "locked": { "type": "boolean" },
                "text": { "type": "string" },
                "transform": { "type": "object" },
                "audio": { "type": "object" },
                "effects": { "type": "array" },
                "keyframes": { "type": "object" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "markers": { "type": "array" }
  },
  "additionalProperties": false
}
