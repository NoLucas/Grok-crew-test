{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grok-crew.control-job/v1",
  "type": "object",
  "required": ["schema", "id", "project_id", "base_revision", "settings", "execution_policy", "publish_policy"],
  "properties": {
    "schema": { "const": "grok-crew.control-job/v1" },
    "id": { "type": "string" },
    "project_id": { "type": "string" },
    "base_revision": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "control_sequence": { "type": "integer", "minimum": 0 },
    "status": { "type": "string" },
    "runner_id": { "type": ["string", "null"] },
    "settings": { "type": "object" },
    "execution_policy": { "enum": ["auto_edit_render", "review_before_render"] },
    "publish_policy": { "$ref": "publish-policy-v1.schema.json" },
    "media_packet": { "type": "object" }
  },
  "additionalProperties": true
}
