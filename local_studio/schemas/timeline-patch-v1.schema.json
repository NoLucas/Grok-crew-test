{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grok-crew.timeline-patch/v1",
  "type": "object",
  "required": ["schema", "base_revision", "origin", "operations"],
  "properties": {
    "schema": { "const": "grok-crew.timeline-patch/v1" },
    "base_revision": { "type": "integer", "minimum": 1 },
    "origin": { "enum": ["human", "remote_bot", "local_system"] },
    "created_by": { "type": "string" },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": { "enum": ["add_track", "update_track", "remove_track", "add_clip", "update_clip", "move_clip", "remove_clip", "split_clip", "set_settings", "add_marker", "remove_marker"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
